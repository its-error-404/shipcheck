{
  "name": "shipcheck",
  "private": true,
  "version": "0.1.0",
  "description": "Tool-using AI agent that assesses Jira release readiness",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "verify-jira": "tsx apps/cli/src/index.ts verify-jira",
    "import": "tsx apps/cli/src/index.ts import",
    "verify-import": "tsx apps/cli/src/index.ts verify-import",
    "assess": "tsx apps/cli/src/index.ts assess",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "verify-llm": "tsx apps/cli/src/index.ts verify-llm",
    "evaluate": "tsx apps/cli/src/index.ts evaluate",
    "setup:ollama": "powershell -ExecutionPolicy Bypass -File scripts/setup-ollama.ps1",
    "serve": "tsx apps/server/src/index.ts",
    "web:dev": "npm run dev -w @shipcheck/web",
    "web:build": "npm run build -w @shipcheck/web",
    "ui": "npm run web:build && npm run serve"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "axios-mock-adapter": "2.1.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
