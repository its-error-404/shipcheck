# Copy to .env and fill in. Never commit .env.

# ── Jira ─────────────────────────────────────────────
# Classic API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TYN
# Parallel workers for import / verify (lower it if Jira rate-limits you)
JIRA_CONCURRENCY=4

# ── LLM (any OpenAI-compatible endpoint) ─────────────
# Free Gemini key: https://aistudio.google.com → Get API key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Exact model name from AI Studio (a Gemini Flash model on the free tier)
LLM_MODEL=
LLM_PROVIDER=gemini
# Stay under your free-tier requests-per-minute limit
LLM_RPM=8
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=8192
# Optional for thinking models: low | medium | high (low = faster, fewer tokens)
LLM_REASONING_EFFORT=low
# Per-request timeout; lower it to fail over faster when a model is overloaded
LLM_TIMEOUT_MS=120000
# USD per 1M tokens, for the cost estimate (0 on free tiers)
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# ── Assessment defaults (CLI flags override) ─────────
ASSESS_SCOPE_LABEL=tyn-release-assessment-v2
ASSESS_RELEASE=R2.4
ASSESS_CONCURRENCY=1
